---
import Hero from '../layouts/Hero.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// === Papers === (pulled from Google Scholar; update as new papers come out)
const papers = [
	{
		title: 'Where Does Social Reasoning Come From? Capability Provenance in Language Models',
		authors: 'G Matlin, C Chakraborty, S Eom, M Okamoto, R Castilla, et al.',
		venue: 'Conference on Language Modeling (COLM)',
		venueLink: 'https://colmweb.org/',
		year: 2026,
		coFirst: false,
		link: 'https://arxiv.org/abs/2606.19625',
		website: 'https://hcailab-gt.github.io/capabilibara/',
		github: 'https://github.com/hcailab-gt/capabilibara',
		huggingface: 'https://huggingface.co/spaces/HCAI-Lab/capabilibara',
		workshops:
			'Also at COLM workshops: <a href="https://science-ai-2026.github.io/" target="_blank" rel="noopener">Sci-FM</a> and <a href="https://sites.google.com/view/social-sims-with-llms/" target="_blank" rel="noopener">Social Sim\'26</a>',
	},
	{
		title: 'On the Quantization Robustness of Diffusion Language Models in Coding Benchmarks',
		authors: 'A Gupta, G Deshpande, C Chakraborty',
		venue: 'arXiv preprint',
		year: 2026,
		coFirst: true,
		link: 'https://arxiv.org/abs/2604.20079',
		github: 'https://github.com/zinichakraborty/Diffusion-LLM-Quantization-Robustness',
	},
	{
		title: 'Do Language Models Agree with Human Perceptions of Suspense in Stories?',
		authors: 'G Matlin, D Zhang, RB Loza, DM Popescu, J Isbell, C Chakraborty, et al.',
		venue: 'Conference on Language Modeling (COLM)',
		venueLink: 'https://colmweb.org/2025/',
		year: 2025,
		coFirst: false,
		link: 'https://arxiv.org/abs/2508.15794',
		github: 'https://github.com/eilab-gt/SuspensePerception',
	},
	{
		title: 'Diffusion Model for Generating Inorganic Materials with Targeted Density of States',
		authors: 'C Chakraborty',
		venue: 'Georgia Institute of Technology',
		year: 2025,
		coFirst: false,
		link: 'https://repository.gatech.edu/entities/publication/ed62e6cb-43c1-445f-b9a5-5bd4b261ed89',
	},
];

// Mark co-first authors with * and bold the site owner's name.
const formatAuthors = (paper) => {
	const names = paper.coFirst
		? paper.authors
				.split(', ')
				.map((name) => (name === 'et al.' ? name : `${name}*`))
				.join(', ')
		: paper.authors;
	return names.replace(
		paper.coFirst ? 'C Chakraborty*' : 'C Chakraborty',
		`<strong>C Chakraborty${paper.coFirst ? '*' : ''}</strong>`,
	);
};

// Short label for each paper's link chip.
const paperLinkLabel = (url: string) =>
	url.includes('arxiv.org') ? 'arXiv' : url.includes('gatech.edu') ? 'Repository' : 'View paper';

// === Contributions ===
const contributions = [
	{
		date: '2026',
		org: 'TransformerLens',
		orgLink: 'https://github.com/TransformerLensOrg/TransformerLens',
		body: 'Added support and tests for mechanistically interpreting Google’s T5Gemma2 multimodal model.',
		link: 'https://github.com/TransformerLensOrg/TransformerLens/pull/1495',
	},
	{
		date: '2024',
		org: 'Bits of Good',
		orgLink: 'https://bitsofgood.org',
		body: 'Co-implemented an SDK, email/Amazon S3 file services, and user onboarding for faster app deployment.',
		link: 'https://github.com/GTBitsOfGood/juno',
	},
	{
		date: '2024',
		org: 'Heart of Passion (Non-Profit)',
		orgLink: 'https://www.heartofpassion.org/',
		body: 'Co-built a donation and event coordination platform for the non-profit, giving chapter organizers a single place to manage retreats for teens fighting cancer.',
		link: 'https://github.com/GTBitsOfGood/heart-of-passion',
	},
	{
		date: '2026',
		org: 'Pruna AI',
		orgLink: 'https://github.com/PrunaAI/pruna',
		body: 'Wrote a tutorial benchmarking Stable Diffusion vision model optimizations on energy use, CO2, and image quality.',
		link: 'https://github.com/PrunaAI/pruna/pull/711',
	},
];
---

<Hero title={SITE_TITLE} description={SITE_DESCRIPTION} bare>
	<section id="home" class="card section section-home">
		<div class="hero-head">
			<div class="hero-head-text">
				<h1 class="hero-name">Hi, I'm Chandreyi (Zini) Chakraborty</h1>
				<p class="hero-fact">BS/MS CS @ Georgia Tech &nbsp;|&nbsp; AI Interpretability Research</p>
			</div>
			<img
				class="hero-avatar"
				src="/profilepic.png"
				alt="Chandreyi (Zini) Chakraborty"
				width="860"
				height="780"
			/>
		</div>
		<p class="hero-tagline">
			I earned my Masters and Bachelors in Computer Science from
			<a href="https://www.gatech.edu" target="_blank" rel="noopener noreferrer">Georgia Tech</a>,
			both with machine learning concentrations. My research focuses on uncovering LLM inner
			workings through mechanistic interpretability, and leveraging those insights to improve model
			capability and efficiency.
		</p>
		<p class="hero-tagline">
			I second-authored a
			<a href="https://arxiv.org/abs/2606.19625" target="_blank" rel="noopener noreferrer"
				>paper accepted to COLM 2026</a
			> that attributes social reasoning to pre-training data at the corpus level using influence functions and machine unlearning. This was in collaboration with
			<a href="https://www.eleuther.ai" target="_blank" rel="noopener noreferrer">EleutherAI</a> as a member of the
			<a href="https://eilab.gatech.edu" target="_blank" rel="noopener noreferrer"
				>Entertainment Intelligence and Human-Centered AI Lab</a
			> under
			<a href="https://eilab.gatech.edu/mark-riedl.html" target="_blank" rel="noopener noreferrer"
				>Dr. Mark Riedl</a>. I also published on
			<a href="https://arxiv.org/abs/2508.15794" target="_blank" rel="noopener noreferrer"
				>how LLMs understand suspense in stories (COLM 2025)</a
			>.
		</p>
		<p class="hero-tagline">
			I was a Machine Learning Teaching Assistant under
			<a href="https://mahdi-roozbahani.github.io/" target="_blank" rel="noopener noreferrer"
				>Dr. Mahdi Roozbahani</a
			>, where I developed a
			<a
				href="https://huggingface.co/ML-GT/Llama-3.3-70B-Instruct-Edubuddy"
				target="_blank"
				rel="noopener noreferrer">Socratic LLM agent</a
			> that supports TAs in responding to student questions on EdStem with LoRA
			fine-tuning and dynamic RAG databases.
		</p>
		<p class="hero-tagline">
			On the efficiency side, I have worked with different LLM architectures and GPU configurations for optimal compute and accuracy. I co-first-authored a
			<a href="https://arxiv.org/abs/2604.20079" target="_blank" rel="noopener noreferrer"
				>paper on the quantization robustness of diffusion LLMs</a
			> against autoregressive LLMs.
		</p>
		<p class="hero-tagline">
			Previously, I worked at
			<a
				href="https://professional.bloomberg.com/products/bloomberg-terminal/"
				target="_blank"
				rel="noopener noreferrer">Bloomberg</a
			>
			on the Terminal, building an efficient portfolio aggregation service, and before that at
			<a href="https://www.deloitte.com" target="_blank" rel="noopener noreferrer">Deloitte</a>,
			where I worked with the Tennessee state government to enhance their Eligibility Benefits
			Management Portal and integrate SummerEBT Appeals.
		</p>
	</section>

	<section id="publications" class="card section">
		<h2 class="section-title">Publications</h2>
		<ol class="papers">
			{
				papers.map((paper) => (
					<li class="paper">
						<span class="year">{paper.year}</span>
						<div class="content">
							<span class="title" title={paper.title}>{paper.title}</span>
							<span class="authors" set:html={formatAuthors(paper)} />
							<span class="venue">
								<em>
									{
										paper.venueLink ? (
											<a href={paper.venueLink} target="_blank" rel="noopener">
												{paper.venue}
											</a>
										) : (
											paper.venue
										)
									}
								</em>
								{paper.coFirst && <span class="cofirst">*Equal contribution</span>}
							</span>
							{paper.workshops && <span class="workshops" set:html={paper.workshops} />}
							<a class="paper-link" href={paper.link} target="_blank" rel="noopener">
								{paper.link.includes('arxiv.org') ? (
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path
											fill="currentColor"
											d="M3.8423 0a1.0037 1.0037 0 0 0-.922.6078c-.1536.3687-.0438.6275.2938 1.1113l6.9185 8.3597-1.0223 1.1058a1.0393 1.0393 0 0 0 .003 1.4229l1.2292 1.3135-5.4391 6.4444c-.2803.299-.4538.823-.2971 1.1986a1.0253 1.0253 0 0 0 .9585.635.9133.9133 0 0 0 .6891-.3405l5.783-6.126 7.4902 8.0051a.8527.8527 0 0 0 .6835.2597.9575.9575 0 0 0 .8777-.6138c.1577-.377-.017-.7502-.306-1.1407l-7.0518-8.3418 1.0632-1.13a.9626.9626 0 0 0 .0089-1.3165L4.6336.4639s-.3733-.4535-.768-.463zm0 .272h.0166c.2179.0052.4874.2715.5644.3639l.005.006.0052.0055 10.169 10.9905a.6915.6915 0 0 1-.0072.945l-1.0666 1.133-1.4982-1.7724-8.5994-10.39c-.3286-.472-.352-.6183-.2592-.841a.7307.7307 0 0 1 .6704-.4401Zm14.341 1.5701a.877.877 0 0 0-.6554.2418l-5.6962 6.1584 1.6944 1.8319 5.3089-6.5138c.3251-.4335.479-.6603.3247-1.0292a1.1205 1.1205 0 0 0-.9763-.689zm-7.6557 12.2823 1.3186 1.4135-5.7864 6.1295a.6494.6494 0 0 1-.4959.26.7516.7516 0 0 1-.706-.4669c-.1119-.2682.0359-.6864.2442-.9083l.0051-.0055.0047-.0055z"
										/>
									</svg>
								) : (
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path
											fill="currentColor"
											d="M9.293 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.707A1 1 0 0 0 13.707 4L10 .293A1 1 0 0 0 9.293 0zM9.5 3.5v-2l3 3h-2a1 1 0 0 1-1-1zM4.5 9a.5.5 0 0 1 0-1h7a.5.5 0 0 1 0 1h-7zM4 10.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm.5 2.5a.5.5 0 0 1 0-1h4a.5.5 0 0 1 0 1h-4z"
										/>
									</svg>
								)}
								{paperLinkLabel(paper.link)}
							</a>
							{paper.github && (
								<a class="paper-link" href={paper.github} target="_blank" rel="noopener">
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path
											fill="currentColor"
											d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
										/>
									</svg>
									GitHub
								</a>
							)}
							{paper.website && (
								<a class="paper-link" href={paper.website} target="_blank" rel="noopener">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path
											fill="currentColor"
											d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
										/>
									</svg>
									Website
								</a>
							)}
							{paper.huggingface && (
								<a class="paper-link" href={paper.huggingface} target="_blank" rel="noopener">
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<circle cx="12" cy="10.2" r="8" fill="currentColor" />
										<path
											fill="currentColor"
											d="M3.4 16.2a1.05 1.05 0 0 1 2.1 0 1.05 1.05 0 0 1 2.1 0 1.05 1.05 0 0 1 2.1 0v3a1.8 1.8 0 0 1-1.8 1.8H5.2a1.8 1.8 0 0 1-1.8-1.8zm10.9 0a1.05 1.05 0 0 1 2.1 0 1.05 1.05 0 0 1 2.1 0 1.05 1.05 0 0 1 2.1 0v3a1.8 1.8 0 0 1-1.8 1.8h-2.7a1.8 1.8 0 0 1-1.8-1.8z"
										/>
									</svg>
									HF
								</a>
							)}
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section id="contributions" class="card section">
		<h2 class="section-title">Contributions</h2>
		<ul class="news">
			{
				contributions.map((item) => (
					<li class="item">
						<span class="date">{item.date}</span>
						<div class="content">
							<div class="org-row">
								{item.orgLink ? (
									<a class="org" href={item.orgLink} target="_blank" rel="noopener">
										{item.org}
									</a>
								) : (
									<span class="org">{item.org}</span>
								)}
								{item.role && <span class="role">{item.role}</span>}
							</div>
							<p class="body">{item.body}</p>
							{item.link && (
								<a class="item-link" href={item.link} target="_blank" rel="noopener">
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path
											fill="currentColor"
											d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
										/>
									</svg>
									GitHub
								</a>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</section>
</Hero>

<style>
	/* On wide screens the bio fills the left column while Publications and
	   Contributions stack in the right column (grid defined in global.css);
	   each section renders as its own elevated card. Breakpoint matches
	   global.css: the two columns fit at 80rem. */
	@media (min-width: 80rem) {
		#home {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
		#publications {
			grid-column: 2;
			grid-row: 1;
		}
		#contributions {
			grid-column: 2;
			grid-row: 2;
		}
	}

	/* Publications and Contributions render narrower than the bio card,
	   but only in the two-column layout; stacked in a single column all
	   cards share the same width. */
	@media (min-width: 80rem) {
		#publications,
		#contributions {
			max-width: 34rem;
			justify-self: center;
		}
	}

	/* === Section headings === */
	.section-title {
		font-size: 1.35rem;
		letter-spacing: -0.01em;
		margin: 1.5rem 0 0.85rem;
	}
	.section-title:first-of-type {
		margin-top: 0.25rem;
	}

	/* === Home hero === */
	/* Name + credential line on the left, photo on the right. The row never
	   wraps, so the photo always stays beside the text; the text column
	   shrinks instead (the credential line wraps below 40rem), and on wide
	   cards it never gets narrower than the nowrap line. */
	.hero-head {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem 1rem;
		margin-bottom: 0.85rem;
	}
	.hero-head-text {
		flex: 1 1 0;
		/* Measured width of the nowrap credential line (~399px), so the
		   line can never be squeezed or slide under the photo; relaxed
		   below 40rem where the line wraps instead. */
		min-width: 25rem;
	}
	.hero-fact {
		margin: 0;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		color: rgba(255, 255, 255, 0.7);
		white-space: nowrap;
	}
	:root[data-theme='light'] .hero-fact {
		color: rgba(0, 0, 0, 0.6);
	}
	.hero-tagline a {
		color: var(--link);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		text-decoration-color: color-mix(in srgb, var(--link) 45%, transparent);
		transition:
			color 0.18s ease,
			text-decoration-color 0.18s ease;
	}
	.hero-tagline a:hover,
	.hero-tagline a:focus-visible {
		color: var(--link-hover);
		text-decoration-color: var(--link-hover);
	}
	/* Rounded-rectangle portrait with a bright ring, beside the name. */
	.hero-avatar {
		flex: 0 0 auto;
		width: 108px;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 16px;
		box-shadow:
			0 0 0 2px rgba(255, 255, 255, 0.4),
			0 10px 30px rgba(0, 0, 0, 0.35);
		transition: transform 0.25s ease;
	}
	.hero-avatar:hover {
		transform: scale(1.04);
	}
	:root[data-theme='light'] .hero-avatar {
		box-shadow:
			0 0 0 2px rgba(0, 0, 0, 0.12),
			0 10px 30px rgba(0, 0, 0, 0.2);
	}

	/* === Papers === */
	.papers {
		list-style: none;
		padding: 0;
		margin: 1.25rem 0 0 0;
	}
	/* Rows bleed to the card edges so their hairlines and hover washes span
	   the full panel width; --card-pad-x comes from .card in global.css. */
	.paper {
		display: grid;
		/* Year in a fixed left column, matching the contribution rows below. */
		grid-template-columns: 3rem 1fr;
		gap: 0.3rem 1rem;
		margin-inline: calc(-1 * var(--card-pad-x));
		padding: 0.8rem var(--card-pad-x);
		border-top: 1px solid var(--hairline);
		transition: background-color 0.2s ease;
	}
	.paper:hover {
		background-color: var(--row-hover);
	}
	.year {
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
		/* Nudged down to sit on the title's baseline rather than its cap. */
		padding-top: 0.3rem;
		opacity: 0.6;
		white-space: nowrap;
	}
	.content {
		min-width: 0;
	}
	.title {
		font-weight: 700;
		font-size: 1.1rem;
		line-height: 1.4;
		/* Accent-colored heading text (not a link — the chip carries that). */
		color: var(--link);
		/* Clamp long titles to two lines; the full title is in the tooltip. */
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
	}
	.authors {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.92rem;
		line-height: 1.5;
	}
	.venue {
		display: block;
		margin-top: 0.2rem;
		font-size: 0.88rem;
		opacity: 0.7;
	}
	.cofirst {
		margin-left: 0.5rem;
		font-size: 0.8rem;
		opacity: 0.7;
	}
	.venue a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}
	.workshops {
		display: block;
		margin-top: 0.2rem;
		font-size: 0.88rem;
		opacity: 0.7;
	}
	.workshops :global(a) {
		color: inherit;
		font-style: italic;
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}
	.workshops :global(a):hover {
		color: inherit;
		text-decoration-thickness: 1.5px;
	}

	/* === Contributions === */
	.news {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0 0;
	}
	.item {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: 1rem;
		margin-inline: calc(-1 * var(--card-pad-x));
		padding: 0.8rem var(--card-pad-x);
		border-top: 1px solid var(--hairline);
		transition: background-color 0.2s ease;
	}
	.item:hover {
		background-color: var(--row-hover);
	}
	.date {
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
		padding-top: 0.1rem;
		opacity: 0.65;
		white-space: nowrap;

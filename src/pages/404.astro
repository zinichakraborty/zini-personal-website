---
import Hero from '../layouts/Hero.astro';
import { SITE_TITLE } from '../consts';
---

<Hero title={`Not found | ${SITE_TITLE}`} description="Page not found." centered>
	<span class="hero-penguin">
		<img class="penguin-still" src="/penguin-favicon.svg" alt="Penguin" width="256" height="256" />
		<img
			class="penguin-wave"
			src="/penguin-wave.svg"
			alt=""
			aria-hidden="true"
			width="256"
			height="256"
		/>
	</span>
	<h2 class="hero-name">404</h2>
	<p class="hero-tagline">that page doesn’t exist</p>
	<p>
		<a class="home-link" href="/">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					fill="currentColor"
					d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
				/>
			</svg>
			back home
		</a>
	</p>
</Hero>

<style>
	.hero-penguin {
		position: relative;
		display: inline-block;
		width: 99px;
		height: 99px;
		animation: penguin-bob 3s ease-in-out infinite;
	}
	@keyframes penguin-bob {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-8px);
		}
	}
	.hero-penguin img {
		display: block;
		width: 100%;
		height: auto;
	}
	.hero-penguin .penguin-wave {
		position: absolute;
		inset: 0;
		display: none;
	}
	.hero-penguin:hover .penguin-still {
		display: none;
	}
	.hero-penguin:hover .penguin-wave {
		display: block;
	}
	/* Same pill chip as the home page's GitHub/paper links. */
	.home-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.28rem 0.75rem;
		font-size: 0.8rem;
		font-weight: 600;
		white-space: nowrap;
		color: var(--link);
		text-decoration: none;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		transition:
			color 0.18s ease,
			background-color 0.18s ease,
			border-color 0.18s ease,
			transform 0.18s ease;
	}
	.home-link:hover {
		color: var(--link-hover);
		background: rgba(255, 255, 255, 0.11);
		border-color: color-mix(in srgb, var(--link) 55%, transparent);
		transform: translateY(-1px);
	}
	.home-link svg {
		width: 0.95rem;
		height: 0.95rem;
		flex: 0 0 auto;
	}
	:global(:root[data-theme='light']) .home-link {
		background: rgba(0, 0, 0, 0.04);
		border-color: rgba(0, 0, 0, 0.14);
	}
	:global(:root[data-theme='light']) .home-link:hover {
		background: rgba(0, 0, 0, 0.08);
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-penguin {
			animation: none;
		}
	}
</style>
